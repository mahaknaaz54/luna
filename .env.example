# Client-side (Public)
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side / AI (Secret - configure in Netlify Dashboard -> Site Configuration -> Environment Variables)
